# Optional for public repositories; required for private repositories and higher rate limits.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# LangChain release-planning model. Keep the API key in .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Prometheus base URL, reachable from the API container.
PROMETHEUS_URL=http://host.docker.internal:9090

# Kubernetes API and a read-only service-account token with access to Argo Rollouts.
KUBERNETES_API_URL=https://your-kubernetes-api:6443
KUBERNETES_TOKEN=